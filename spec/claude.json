{
    "name": "claude",
    "base_url": "https://api.anthropic.com",
    "enums": {
        "claude_model": {
            "values": [
                { "name": "claude-sonnet-5" },
                { "name": "claude-haiku-4-5" },
                { "name": "claude-opus-5" },
                { "name": "claude-fable-5" }
            ]
        },
        "claude_role": {
            "values": [
                { "name": "user" },
                { "name": "assistant" }
            ]
        },
        "claude_content_type": {
            "description": "Discriminator for a content block. Matches the Anthropic wire format; unknown values deserialize as UNDEFINED and are skipped downstream.",
            "values": [
                { "name": "text" },
                { "name": "tool_use" },
                { "name": "tool_result" },
                { "name": "thinking" },
                { "name": "redacted_thinking" },
                { "name": "image" },
                { "name": "document" }
            ]
        },
        "claude_source_type": {
            "values": [
                { "name": "base64" }
            ]
        },
        "claude_media_type": {
            "values": [
                { "name": "image_jpeg", "value": "image/jpeg" },
                { "name": "image_png", "value": "image/png" },
                { "name": "image_gif", "value": "image/gif" },
                { "name": "image_webp", "value": "image/webp" },
                { "name": "application_pdf", "value": "application/pdf" }
            ]
        },
        "claude_stop_reason": {
            "values": [
                { "name": "end_turn" },
                { "name": "max_tokens" },
                { "name": "stop_sequence" },
                { "name": "tool_use" },
                { "name": "refusal" }
            ]
        },
        "claude_output_format_type": {
          "values": [
            { "name": "json_schema" }
          ]
        },
        "claude_cache_type": {
            "values": [
                { "name": "ephemeral" }
            ]
        },
        "claude_thinking_type": {
            "values": [
                { "name": "disabled" },
                { "name": "adaptive" }
            ]
        },
        "claude_tool_choice_type": {
            "values": [
                { "name": "auto" },
                { "name": "any" },
                { "name": "tool" },
                { "name": "none" }
            ]
        },
        "claude_effort": {
            "values": [
                { "name": "low" },
                { "name": "medium" },
                { "name": "high" },
                { "name": "xhigh" },
                { "name": "max" }
            ]
        },
        "claude_task_budget_type": {
            "description": "Unit a task budget is denominated in. The API defines exactly one.",
            "values": [
                { "name": "tokens" }
            ]
        }
    },

    "models": {
        "claude_request": {
            "fields": [
                { "name": "model", "type": "claude_model" },
                { "name": "messages", "type": "[claude_message]" },
                { "name": "max_tokens", "type": "long", "default": 30000 },
                { "name": "system", "type": "[claude_system_block]", "required": false },
                { "name": "tools", "type": "[claude_tool]", "required": false },
                { "name": "tool_choice", "type": "claude_tool_choice", "required": false },
                { "name": "output_config", "type": "claude_output_config", "required": false },
                { "name": "thinking", "type": "claude_thinking", "required": false }
            ]
        },
        "claude_thinking": {
            "fields": [
                { "name": "type", "type": "claude_thinking_type" }
            ]
        },
        "claude_cache_control": {
            "fields": [
                { "name": "type", "type": "claude_cache_type", "default": "ephemeral" },
                { "name": "ttl", "type": "string", "required": false, "description": "How long an entry written at this breakpoint stays readable: \"5m\" or \"1h\". Omitted means the API default of 5 minutes. A string rather than an enum because apibuilder's Scala generator names the case object after the wire value, and neither value is a legal Scala identifier; the type-safe choice lives on AiRequest.cacheTtl instead, which is the surface callers actually use." }
            ]
        },
        "claude_source": {
            "fields": [
                { "name": "type", "type": "claude_source_type" },
                { "name": "media_type", "type": "claude_media_type" },
                { "name": "data", "type": "string", "description": "Base64 encoded content" }
            ]
        },
        "claude_system_block": {
            "fields": [
                { "name": "type", "type": "claude_content_type", "default": "text" },
                { "name": "text", "type": "string" },
                { "name": "cache_control", "type": "claude_cache_control", "required": false }
            ]
        },
        "claude_tool": {
            "description": "A tool the model may call. input_schema is the JSON schema for the tool's arguments; strict guarantees the model's input validates against it.",
            "fields": [
                { "name": "name", "type": "string" },
                { "name": "description", "type": "string" },
                { "name": "input_schema", "type": "object" },
                { "name": "strict", "type": "boolean", "required": false },
                { "name": "cache_control", "type": "claude_cache_control", "required": false }
            ]
        },
        "claude_tool_choice": {
            "fields": [
                { "name": "type", "type": "claude_tool_choice_type" },
                { "name": "name", "type": "string", "required": false },
                { "name": "disable_parallel_tool_use", "type": "boolean", "required": false }
            ]
        },
        "claude_output_config": {
            "description": "Output controls. effort tunes thinking depth and token spend; format constrains the response to a JSON schema (replaces the deprecated top-level output_format); task_budget tells the model how much of max_tokens it should plan to spend.",
            "fields": [
                { "name": "effort", "type": "claude_effort", "required": false },
                { "name": "format", "type": "claude_api_output_format", "required": false },
                { "name": "task_budget", "type": "claude_task_budget", "required": false }
            ]
        },
        "claude_task_budget": {
            "description": "Advisory token ceiling the model is made aware of while generating. The server injects a countdown marker, so the model paces itself and wraps up gracefully instead of being truncated at max_tokens -- which is an enforced ceiling the model never sees. Requires the task-budgets-2026-03-13 beta header.",
            "fields": [
              { "name": "type", "type": "claude_task_budget_type", "default": "tokens" },
              { "name": "total", "type": "long", "description": "Tokens the model may plan to spend on this turn. Minimum accepted by the API is 20,000; anything lower is rejected." }
            ]
        },
        "claude_api_output_format": {
            "description": "Structured output configuration for guaranteed JSON schema compliance",
            "fields": [
              { "name": "type", "type": "claude_output_format_type", "default": "json_schema" },
              { "name": "schema", "type": "object", "description": "JSON schema object defining the structure" }
            ]
        },
        "claude_message": {
            "fields": [
                { "name": "role", "type": "claude_role" },
                { "name": "content", "type": "[claude_content_block]" }
            ]
        },
        "claude_content_block": {
            "description": "One content block on a message or response. A single flat model spanning all block types (discriminated on type) rather than a union, because a spec that has both a union and error-response mustParse handling hits a known bryzek-generator ambiguous-implicit compile error. Wire JSON is identical to the union form; only the populated fields differ by type: text -> text; tool_use -> id, name, input; tool_result -> tool_use_id, content, is_error; thinking -> thinking, signature; redacted_thinking -> data; image -> source; document -> source. Retain every field verbatim when echoing assistant content back, or the API rejects the modified block.",
            "fields": [
                { "name": "type", "type": "claude_content_type" },
                { "name": "text", "type": "string", "required": false },
                { "name": "id", "type": "string", "required": false },
                { "name": "name", "type": "string", "required": false },
                { "name": "input", "type": "object", "required": false },
                { "name": "tool_use_id", "type": "string", "required": false },
                { "name": "content", "type": "string", "required": false },
                { "name": "is_error", "type": "boolean", "required": false },
                { "name": "thinking", "type": "string", "required": false },
                { "name": "signature", "type": "string", "required": false },
                { "name": "data", "type": "string", "required": false },
                { "name": "source", "type": "claude_source", "required": false },
                { "name": "cache_control", "type": "claude_cache_control", "required": false }
            ]
        },
        "claude_response": {
            "fields": [
                { "name": "id", "type": "string" },
                { "name": "type", "type": "string" },
                { "name": "role", "type": "claude_role" },
                { "name": "content", "type": "[claude_content_block]" },
                { "name": "model", "type": "claude_model" },
                { "name": "stop_reason", "type": "claude_stop_reason" },
                { "name": "stop_sequence", "type": "string", "required": false },
                { "name": "usage", "type": "claude_usage" }
            ]
        },
        "claude_usage": {
            "fields": [
                { "name": "input_tokens", "type": "long" },
                { "name": "output_tokens", "type": "long" },
                { "name": "cache_creation_input_tokens", "type": "long", "required": false },
                { "name": "cache_read_input_tokens", "type": "long", "required": false },
                { "name": "cache_creation", "type": "claude_cache_creation", "required": false }
            ]
        },
        "claude_cache_creation": {
            "description": "cache_creation_input_tokens split by the TTL each write was made at. Without this split a 1h write (2x input) is indistinguishable from a 5m one (1.25x) and any cost rollup over the total under-reports it -- which is exactly the direction that would hide a longer TTL that stopped paying for itself.",
            "fields": [
                { "name": "ephemeral_5m_input_tokens", "type": "long", "default": 0 },
                { "name": "ephemeral_1h_input_tokens", "type": "long", "default": 0 }
            ]
        },
        "claude_error_response": {
            "fields": [
                { "name": "error", "type": "claude_error" }
            ]
        },
        "claude_error": {
            "fields": [
                { "name": "message", "type": "string" },
                { "name": "raw", "type": "string", "required": false }
            ]
        },
        "message": {
            "fields": [
                { "name": "placeholder", "type": "string", "required": false }
            ]
        }
    },
    "resources": {
        "message": {
            "path": "/v1/messages",
            "operations": [
                {
                    "method": "post",
                    "body": "claude_request",
                    "responses": {
                        "200": { "type": "claude_response" },
                        "400": { "type": "claude_error_response" },
                        "401": { "type": "claude_error_response" },
                        "403": { "type": "claude_error_response" },
                        "429": { "type": "claude_error_response" },
                        "500": { "type": "claude_error_response" }
                    }
                }
            ]
        }
    }
}
